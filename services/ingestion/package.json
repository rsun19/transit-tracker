{
  "name": "@transit-tracker/ingestion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/worker",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage --passWithNoTests",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "@transit-tracker/shared": "file:../../packages/shared",
    "cron": "3.2.1",
    "csv-parser": "^3.0.0",
    "gtfs-realtime-bindings": "^1.1.1",
    "ioredis": "^5.3.2",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3",
    "pg-copy-streams": "6.0.6",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17",
    "unzipper": "^0.12.3",
    "zod": "^3.22.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/__fixtures__/**",
      "!worker.ts"
    ],
    "coverageReporters": [
      "json-summary",
      "json",
      "lcov",
      "text",
      "clover"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.21",
    "@types/ioredis-mock": "^8.2.8",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/unzipper": "^0.10.9",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.2"
  }
}
